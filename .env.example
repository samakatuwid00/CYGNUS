# Cygnus - settings
# Copy this file to .env, then set the two lines under "Your model" below.
# .env holds your API key: never commit it, never share it, never paste it
# into a chat or a screenshot. It is already in .gitignore.

# =============================================================================
# YOUR MODEL (the only part you have to fill in)
# =============================================================================
# Pick ONE provider and paste your key. docs/API_KEY.md walks through getting
# a key for each, step by step.
#
#   gemini      Google AI Studio. Free, no credit card. Recommended to start.
#   openai      OpenAI. Paid: set a monthly spending limit on your account.
#   groq        Groq. Free tier, fast.
#   openrouter  OpenRouter. Many models, some free; set CYGNUS_MODEL too.
#   ollama      A model on this laptop through Ollama. No key, nothing leaves
#               the machine, slower. See docs/SETUP.md.
#   custom      Any other OpenAI-compatible endpoint: also set
#               ROUTER_BASE_URL and CYGNUS_MODEL.
CYGNUS_PROVIDER=gemini
CYGNUS_API_KEY=

# Optional: the model to ask. Leave empty for the provider's default
# (for gemini, a list of free models tried in order).
CYGNUS_MODEL=

# How turns are handled: "lead" lets the model use Cygnus's tools in a loop
# (open, look, then answer), which is how Cygnus is built and tested; "off" is
# the older one-step routing. Local-only never uses the loop.
JARVIS_AGENT_LOOP=lead

# Optional: Ollama as a backup when the cloud model is out of quota or the
# network is down. Only if you installed Ollama (https://ollama.com).
# JARVIS_USE_OLLAMA=true

# -----------------------------------------------------------------------------
# Advanced: everything the provider fills in can be written out instead, and
# what is written here wins. Leave these commented unless you know you need
# them.
# -----------------------------------------------------------------------------
# ROUTER_BASE_URL=https://api.openai.com/v1
# ROUTER_MODEL=gpt-5.4-mini
# ROUTER_FALLBACK_MODELS=gpt-5.4
# GOOGLE_AI_MODELS=gemini-3.6-flash,gemini-2.5-flash
# JARVIS_PREFER_LOCAL=false        # true: try Ollama FIRST
# JARVIS_LOCAL_ONLY=false          # true: nothing leaves the machine (also refuses the cloud voice)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen3:4b-instruct
# OLLAMA_MAX_TOKENS=512
# OLLAMA_TIMEOUT=180
# A model's first call in a turn gets this long before the next model is tried.
# JARVIS_FIRST_CALL_S=20
#
# 9router (the author's setup): CYGNUS_PROVIDER=9router, a local proxy for
# accounts he already has. Cygnus starts it when it is down and restarts it
# when it hangs (JARVIS_ROUTER_KEEP=0 turns that off). Do not point it at
# someone else's accounts: those providers' terms do not allow sharing or
# reselling that access.

# =============================================================================
# VOICE ENGINE (Whisper STT + edge-tts TTS)
# =============================================================================
# Requires: pip install faster-whisper sounddevice soundfile edge-tts numpy
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_MODEL=small.en            # medium.en: better, slower, bigger download
WHISPER_CPU_THREADS=8             # Half of available cores
# The names you say: your projects, your apps, the people you mention. The
# single biggest win for speech accuracy - replace these with your own.
WHISPER_INITIAL_PROMPT=Cygnus, dashboard, report, vault, Chrome, Spotify, Notepad

# No microphone, no Whisper, no speech: typed turns only (headless, a machine
# without a mic, or the benchmark). Everything else works as usual.
JARVIS_NO_VOICE=0

# Learn the sites you use often by reading your default browser's History
# database. Off by default: it is your browsing history. The Apps panel can
# always rescan when you ask it to.
JARVIS_SCAN_BROWSER_HISTORY=0

# Wake word detection (Whisper transcript match, not a dedicated engine)
WAKE_WORD=cygnus
WAKE_WORD_TIMEOUT=10
PORCUPINE_ACCESS_KEY=             # Only needed if using Porcupine wake word engine

# Text-to-speech (Microsoft edge-tts, free, requires internet)
TTS_VOICE=en-GB-RyanNeural
TTS_RATE=+20%
TTS_VOLUME=+0%

# Voice state feedback (spoken cues while processing)
JARVIS_VOICE_FEEDBACK=essential   # Options: essential, full, off
JARVIS_VOICE_THINKING_CUE_S=4
JARVIS_VOICE_THINKING_ESCALATE_S=12
JARVIS_VOICE_CUE_COOLDOWN_S=8

# =============================================================================
# MEMORY & SESSION
# =============================================================================
MAX_HISTORY=20                     # Max conversation turns before truncation

# Local Ollama context budget (tokens) — raise only with bigger num_ctx rebuild
JARVIS_LOCAL_HISTORY_TOKENS=3500

# Auto-clear context after inactivity (minutes, 0 = disabled)
JARVIS_IDLE_RESET_MINUTES=10

# =============================================================================
# DEBUG
# =============================================================================
DEBUG=false                        # Set true for verbose logging
