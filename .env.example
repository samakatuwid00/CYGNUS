# JARVIS — Environment Configuration
# Copy this file to .env and fill in your values.
# Every variable below is OPTIONAL — JARVIS has sensible defaults.
# At least one LLM backend must be configured for JARVIS to respond.

# =============================================================================
# LLM BACKENDS (at least one required)
# =============================================================================
# Cygnus tries backends in order until one responds. The chain is:
#   1. Ollama (local, if JARVIS_PREFER_LOCAL=true)
#   2. Cerebras (free tier, if JARVIS_USE_CEREBRAS=true and key set)
#   3. The OpenAI-compatible endpoint below (your key, or a local 9router)
#   4. Ollama (local, always as the last real backend)
#   5. "No model answered" - Cygnus says so rather than inventing an answer
#
# Groq and Gemini config exists but is NOT wired into the live chain.
# See cygnus/brain/core.py for the actual routing order.

# --- Ollama (local, no API key needed, recommended to start) ---
JARVIS_USE_OLLAMA=true
JARVIS_PREFER_LOCAL=false          # Set true to try local FIRST
JARVIS_LOCAL_ONLY=false            # Set true for full offline/privacy mode
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=jarvis-qwen3         # Requires: ollama pull qwen3:4b-instruct
                                   #          then: ollama create jarvis-qwen3 -f Modelfile.jarvis
OLLAMA_API_KEY=ollama             # Ignored by Ollama, client needs non-empty string
OLLAMA_MAX_TOKENS=512
OLLAMA_TIMEOUT=180
OLLAMA_KEEP_WARM=true
OLLAMA_WARM_INTERVAL=240

# --- The brain: where the model calls go -------------------------------------
# Anything OpenAI-compatible. Pick ONE of the three setups below.
#
# (a) Your own key, any OpenAI-compatible endpoint (what most people want):
#       ROUTER_BASE_URL=https://api.openai.com/v1
#       ROUTER_MODEL=gpt-5.4-mini
#       ROUTER_API_KEY=sk-...your key...
#       ROUTER_FALLBACK_MODELS=gpt-5.4
#     OpenRouter, Groq, Together and a LAN server work the same way. Cygnus
#     does not start, stop or probe an endpoint it does not run: it only asks
#     the models you list here, so nobody's bill pays for a model sweep.
#
# (b) Local only, no key, no cloud: leave JARVIS_USE_9ROUTER=false and set
#     JARVIS_USE_OLLAMA=true with JARVIS_PREFER_LOCAL=true above. Slower and
#     weaker, and it never leaves the machine.
#
# (c) 9router (the author's setup): a local proxy for accounts he already has.
#     Cygnus starts it when it is down and restarts it when it hangs. Do not
#     point it at someone else's accounts: those providers' terms do not allow
#     sharing or reselling that access.
JARVIS_USE_9ROUTER=true
ROUTER_BASE_URL=http://localhost:20128/v1
ROUTER_MODEL=ag/claude-sonnet-4-6
ROUTER_API_KEY=dummy              # Must be non-empty; proxy ignores value
# After these, every other 9router model that passes router_health's
# tool-call probe is tried, fastest first.
ROUTER_FALLBACK_MODELS=ag/claude-opus-4-6-thinking,ag/gemini-3.1-pro-low,ag/gemini-3.8-flash-low
# Cygnus starts 9router when it is down and checks it every 30 s
# (router_keeper.py); 0 turns that off.
JARVIS_ROUTER_KEEP=1
# A model's first call in a turn gets this long before the next model is tried.
JARVIS_FIRST_CALL_S=20

# --- Cerebras (free tier, requires API key) ---
JARVIS_USE_CEREBRAS=false
CEREBRAS_API_KEY=                 # Get free key at cerebras.ai
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=gemma-4-31b

# --- Groq (free tier — NOT wired into live chain, exists for future use) ---
JARVIS_USE_GROQ=false
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# --- Gemini (free tier — NOT wired into live chain, exists for future use) ---
GEMINI_API_KEY=                   # Get free key at makersuite.google.com
GEMINI_MODEL=gemini-2.5-flash     # Hardcoded in brain_gemini.py, not read from env

# =============================================================================
# VOICE ENGINE (Whisper STT + edge-tts TTS)
# =============================================================================
# Requires: pip install faster-whisper sounddevice soundfile edge-tts numpy
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_MODEL=medium.en
WHISPER_CPU_THREADS=8             # Half of available cores
WHISPER_INITIAL_PROMPT=JARVIS, Jarvis, DepEd, iRIMS-V, dashboard, report, vault

# Wake word detection (Whisper transcript match, not a dedicated engine)
WAKE_WORD=jarvis
WAKE_WORD_TIMEOUT=10
PORCUPINE_ACCESS_KEY=             # Only needed if using Porcupine wake word engine

# Text-to-speech (Microsoft edge-tts, free, requires internet)
TTS_VOICE=en-GB-RyanNeural
TTS_RATE=+20%
TTS_VOLUME=+0%

# Voice state feedback (spoken cues while processing)
JARVIS_VOICE_FEEDBACK=essential   # Options: essential, full, off
JARVIS_VOICE_THINKING_CUE_S=4
JARVIS_VOICE_THINKING_ESCALATE_S=12
JARVIS_VOICE_CUE_COOLDOWN_S=8

# =============================================================================
# MEMORY & SESSION
# =============================================================================
MAX_HISTORY=20                     # Max conversation turns before truncation

# Local Ollama context budget (tokens) — raise only with bigger num_ctx rebuild
JARVIS_LOCAL_HISTORY_TOKENS=3500

# Auto-clear context after inactivity (minutes, 0 = disabled)
JARVIS_IDLE_RESET_MINUTES=10

# =============================================================================
# DEBUG
# =============================================================================
DEBUG=false                        # Set true for verbose logging
